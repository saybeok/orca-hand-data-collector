# Camera identity/role mapping for the current USB cabling.
# 2026-10-28: operator confirmed the view then labelled video3 as the bottom view.
# That input was HD Camera, USB 1-1.1, serial 200910120001.
# Both HD cameras report that serial, so their USB ports distinguish them.
# Video node numbers can change; keep each camera on the same physical port.
# Current cabling: wrist remains on 1-1.3; other HD input is on 1-1.4.
export ORCA_CAMERA_BOTTOM="bottom:usb=1-1.4:640x480:MJPG@30"

# 2026-10-28: operator confirmed the other HD camera as the wrist view.
export ORCA_CAMERA_WRIST="wrist:usb=1-1.3:640x480:MJPG@30"
# Keep earlier preview commands working, using the now-confirmed image name.
export ORCA_CAMERA_HD_UNASSIGNED="$ORCA_CAMERA_WRIST"

# RealSense device is identified; retain its device name as the image key.
export ORCA_CAMERA_REALSENSE="realsense:serial=261643069030:640x480@30"
